{
  "name": "@gitblog/membership",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent GitBlog membership iframe reader",
  "scripts": {
    "generate": "node scripts/build.mjs",
    "build": "npm run generate && wrangler deploy --dry-run --outdir dist",
    "check": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run",
    "dev": "npm run generate && wrangler dev",
    "deploy": "npm run generate && wrangler deploy"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "wrangler": "4.151.1"
  }
}
